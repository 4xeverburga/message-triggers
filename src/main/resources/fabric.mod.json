{
	"schemaVersion": 1,
	"id": "messagetriggers",
	"version": "${version}",
	"name": "Message Triggers",
	"description": "Bridges Minecraft chat to a localhost HTTP agent bridge. Configurable in-game via /mtriggers.",
	"environment": "client",
	"entrypoints": {
		"client": ["com.messagetriggers.mod.MessageTriggersMod"]
	},
	"mixins": ["messagetriggers.mixins.json"],
	"depends": {
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-command-api-v2": ">=2.0.0"
	}
}
